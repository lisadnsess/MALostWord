{

    "interface_version": 2,
    "name": "MALW",
    "description": "使用 MaaFramework 创建的针对东方归言录的新项目。",
    "contact": "CONTACT",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MALW!",
    "github": "https://github.com/lisadnsess/MALostWord",
    "version": "1.0.0",

    "controller": [
        {
            "name": "ADB",
            "label": "模拟器",
            "type": "Adb"
        },
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "Visual Studio",

                "screencap": "PrintWindow",
                "mouse": "PostMessageWithCursorPos",
                "keyboard": "PostMessageWithCursorPos"
            }
        },
        {
            "name": "PlayCover",
            "type": "PlayCover"
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource/base"
            ],
            "controller": [
                "ADB",
                "PlayCover"
            ]
        }
    ],

     "agent": {
        "child_exec": "python",
        "child_args": [
            "-u",
            "./../agent/main.py"
        ]
    },

    "import": [

      "resource/tasks/preset/Daily.json",
      "resource/tasks/DailyActivity.json"
    ]
}